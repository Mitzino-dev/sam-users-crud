NODE_ENV=local
IS_LOCAL=true
LOG_LEVEL=debug
LOG_PRETTY=false
AWS_REGION=us-east-1

# Base de datos local (Docker). Dentro de la red de SAM el host es el nombre del servicio.
DB_HOST=users-db
DB_PORT=5432
DB_USER=app_user
DB_PASSWORD=app_password
DB_NAME=users_db
DB_MAX_POOL=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000
DB_SSL=false
DB_APP_NAME=sam-users-crud

# Puerto publicado en el host por docker-compose (cambiar si 5432 esta ocupado).
HOST_DB_PORT=5433

# Opcional en produccion: ARN del secreto en Secrets Manager con {username, password}.
# DB_SECRET_ARN=arn:aws:secretsmanager:us-east-1:123456789012:secret:users/db