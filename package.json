{
  "name": "sam-users-crud-ts",
  "version": "1.0.0",
  "description": "Lambda SAM CRUD de usuarios con arquitectura limpia, TS, AJV, Vitest, Docker, logging y seguridad",
  "main": "dist/handlers/usersHandler.js",
  "type": "commonjs",
  "scripts": {
    "build": "esbuild src/handlers/usersHandler.ts --bundle --minify --sourcemap --platform=node --target=node20 --outfile=dist/handlers/usersHandler.js",
    "dev": "sam local start-api --docker-network sam-users-net",
    "invoke": "sam local invoke UsersHandler --event events/api-event.json --docker-network sam-users-net",
    "validate": "sam validate",
    "deploy": "sam build && sam deploy --guided",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d",
    "db:logs": "docker compose logs -f users-db",
    "test:e2e": "node scripts/e2e-smoke.js"
  },
  "keywords": [
    "sam",
    "lambda",
    "node20",
    "typescript",
    "crud",
    "users",
    "solid",
    "oop",
    "ajv",
    "vitest",
    "pg",
    "docker"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-secrets-manager": "^3.1146.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "dotenv": "^16.4.5",
    "pg": "^8.13.1",
    "pino": "^9.5.0"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.145",
    "@types/node": "^22.9.0",
    "@types/pg": "^8.11.10",
    "@vitest/coverage-v8": "^5.0.3",
    "esbuild": "^0.28.2",
    "pino-pretty": "^13.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3",
    "vitest": "^5.0.3"
  }
}
